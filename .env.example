ENABLE_ADVANCED_MATCHING=true

# 💬 Chat Configuration
MAX_MESSAGE_LENGTH=1000
MAX_IMAGES_PER_MESSAGE=5
CHAT_FILE_SIZE_LIMIT=10485760

# 🏪 Marketplace Settings
DEFAULT_CURRENCY=TRY
SUPPORTED_CURRENCIES=TRY,USD,EUR
