rules_version = '2';
// BarterQween Firestore Security Rules
// World-class security with premium features validation
service cloud.firestore {
  match /databases/{database}/documents {
    function _followersList(data) {
      return data != null && data.social != null && data.social.followers is list
          ? data.social.followers
          : [];
    }

    function _followingList(data) {
      return data != null && data.social != null && data.social.following is list
          ? data.social.following
          : [];
    }

    function _isFollowerMutation(userId) {
      let preconditions =
          request.auth != null && request.auth.uid != userId &&
          resource.data != null &&
          request.resource.data.keys().hasOnly(['social', 'updatedAt']) &&
          request.resource.data.social is map &&
          request.resource.data.social.keys().hasOnly(['followers', 'followersCount']) &&
          request.resource.data.social.followers is list &&
          request.resource.data.social.followersCount is int;

      let oldFollowers = _followersList(resource.data);
      let newFollowers = _followersList(request.resource.data);

      let added =
          newFollowers.size() == oldFollowers.size() + 1 &&
          newFollowers.hasAll(oldFollowers) &&
          newFollowers.hasAny([request.auth.uid]) &&
          !oldFollowers.hasAny([request.auth.uid]) &&
          request.resource.data.social.followersCount == newFollowers.size();

      let removed =
          oldFollowers.size() == newFollowers.size() + 1 &&
          oldFollowers.hasAll(newFollowers) &&
          oldFollowers.hasAny([request.auth.uid]) &&
          !newFollowers.hasAny([request.auth.uid]) &&
          request.resource.data.social.followersCount == newFollowers.size();

      return preconditions && (added || removed);
    }

    function _followersSectionMatches() {
      let oldFollowers = resource.data != null && resource.data.social != null
          ? resource.data.social.followers
          : null;
      let newFollowers = request.resource.data.social.followers;
      return (oldFollowers == null && newFollowers == null) ||
             oldFollowers == newFollowers;
    }

    function _followersCountMatches() {
      let oldCount = resource.data != null && resource.data.social != null
          ? resource.data.social.followersCount
          : null;
      let newCount = request.resource.data.social.followersCount;
      return (oldCount == null && newCount == null) ||
             oldCount == newCount;
    }

    function _isFollowingMutation(userId) {
      let preconditions =
          request.auth != null && request.auth.uid == userId &&
          resource.data != null &&
          request.resource.data.keys().hasOnly(['social', 'updatedAt']) &&
          request.resource.data.social is map &&
          request.resource.data.social.keys().hasOnly(['followers', 'followersCount', 'following', 'followingCount']) &&
          request.resource.data.social.following is list &&
          request.resource.data.social.followingCount is int &&
          _followersSectionMatches() &&
          _followersCountMatches();

      let oldFollowing = _followingList(resource.data);
      let newFollowing = _followingList(request.resource.data);

      let added =
          newFollowing.size() == oldFollowing.size() + 1 &&
          newFollowing.hasAll(oldFollowing) &&
          request.resource.data.social.followingCount == newFollowing.size();

      let removed =
          oldFollowing.size() == newFollowing.size() + 1 &&
          oldFollowing.hasAll(newFollowing) &&
          request.resource.data.social.followingCount == newFollowing.size();

      return preconditions && (added || removed);
    }

    function _isProfileUpdate(userId) {
      return request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.social == resource.data.social;
    }

    function _isItemMetricsUpdate() {
      let authorized = request.auth != null && resource.data != null;
      let allowedKeys = request.resource.data.keys().hasOnly(['viewCount', 'favoriteCount', 'shareCount', 'inquiryCount', 'updatedAt']);

      let oldView = resource.data.viewCount == null ? 0 : resource.data.viewCount;
      let viewValid = request.resource.data.viewCount == null ||
          (request.resource.data.viewCount is int &&
           request.resource.data.viewCount >= oldView &&
           request.resource.data.viewCount - oldView <= 1);

      let oldFavorite = resource.data.favoriteCount == null ? 0 : resource.data.favoriteCount;
      let favoriteValid = request.resource.data.favoriteCount == null ||
          (request.resource.data.favoriteCount is int &&
           request.resource.data.favoriteCount >= 0 &&
           (request.resource.data.favoriteCount == oldFavorite ||
            request.resource.data.favoriteCount == oldFavorite + 1 ||
            request.resource.data.favoriteCount == oldFavorite - 1));

      let oldShare = resource.data.shareCount == null ? 0 : resource.data.shareCount;
      let shareValid = request.resource.data.shareCount == null ||
          (request.resource.data.shareCount is int &&
           request.resource.data.shareCount >= oldShare &&
           request.resource.data.shareCount - oldShare <= 1);

      let oldInquiry = resource.data.inquiryCount == null ? 0 : resource.data.inquiryCount;
      let inquiryValid = request.resource.data.inquiryCount == null ||
          (request.resource.data.inquiryCount is int &&
           request.resource.data.inquiryCount >= oldInquiry &&
           request.resource.data.inquiryCount - oldInquiry <= 1);

      return authorized && allowedKeys && viewValid && favoriteValid && shareValid && inquiryValid;
    }
    
    // User profiles - users can read all profiles but only write their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if _isFollowerMutation(userId);
      allow update: if _isFollowingMutation(userId);
      allow update: if _isProfileUpdate(userId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Items - authenticated users can read all active items
    // Only item owners can create/update/delete their own items
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.ownerId &&
                      request.resource.data.title is string &&
                      request.resource.data.title.size() > 0 &&
                      request.resource.data.title.size() <= 100;
      allow update: if request.auth != null && 
                      request.auth.uid == resource.data.ownerId &&
                      request.resource.data.ownerId == resource.data.ownerId; // Prevent owner change
      allow update: if _isItemMetricsUpdate();
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
    
    // Conversations - only participants can read/write
    match /conversations/{conversationId} {
      // Allow get/read if user is a participant
      allow get: if request.auth != null && request.auth.uid in resource.data.participants;
      // Allow list/query if authenticated (filtering is done in the query with arrayContains)
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null && request.auth.uid in resource.data.participants;
    }
    
    // Messages - conversation participants can read, only senders can create
    match /messages/{messageId} {
      // Allow authenticated users to read and query messages (filtering done in query)
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      // Allow users to create messages where they are the sender
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.senderId &&
                      request.resource.data.conversationId != null;
      // Allow marking messages as read
      allow update: if request.auth != null && 
                      (request.auth.uid == resource.data.senderId || 
                       request.resource.data.keys().hasOnly(['isRead']) &&
                       request.resource.data.isRead == true);
    }
    
    // Trade Offers - authenticated users can query to check for existing offers
    match /tradeOffers/{tradeId} {
      // Allow reading for authenticated users (app logic ensures proper filtering)
      allow read: if request.auth != null;
      
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.fromUserId &&
                      request.resource.data.status == 'pending' &&
                      request.resource.data.offeredItemId is string &&
                      request.resource.data.requestedItemId is string &&
                      request.resource.data.toUserId is string;
      allow update: if request.auth != null && 
                      (request.auth.uid == resource.data.fromUserId || 
                       request.auth.uid == resource.data.toUserId) &&
                      // Prevent changing core trade data
                      request.resource.data.fromUserId == resource.data.fromUserId &&
                      request.resource.data.toUserId == resource.data.toUserId &&
                      request.resource.data.offeredItemId == resource.data.offeredItemId &&
                      request.resource.data.requestedItemId == resource.data.requestedItemId &&
                      // Only allow status updates by appropriate user
                      (request.auth.uid == resource.data.toUserId || 
                       request.resource.data.status in ['cancelled', 'completed']);
    }
    
    // Ratings - anyone can read, only raters can create; ensure tradeId present
    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId &&
                    request.resource.data.tradeId is string &&
                    request.resource.data.toUserId is string &&
                    request.resource.data.rating is int;
    }
    
    // Favorites - users can only manage their own favorites
    match /favorites/{favoriteId} {
      allow read, list: if request.auth != null;
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.userId &&
                      request.resource.data.itemId is string &&
                      request.resource.data.itemId.size() > 0;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Reviews - anyone can read, only reviewers can write
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reviewerId;
    }

    // Negotiations - participants can read/write
    match /negotiations/{negotiationId} {
      allow read: if request.auth != null && 
                    (request.auth.uid == resource.data.initiatorId || 
                     request.auth.uid == resource.data.receiverId);
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.initiatorId;
      allow update: if request.auth != null && 
                      (request.auth.uid == resource.data.initiatorId || 
                       request.auth.uid == resource.data.receiverId);
      allow delete: if false; // Server-only via Cloud Functions
    }

    // Counter offers - offerer and target can read/write
    match /counter_offers/{counterOfferId} {
      allow read: if request.auth != null && 
                    (request.auth.uid == resource.data.offererId || 
                     request.auth.uid == resource.data.targetUserId);
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.offererId;
      allow update: if request.auth != null && 
                      request.auth.uid == resource.data.offererId &&
                      request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if false; // Server-only via Cloud Functions
    }
    
    // Notifications - users can only read/write their own notifications
    // New (subcollection under user):
    match /users/{userId}/notifications/{notificationId} {
      allow read, list: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // FCM tokens - per user device tokens
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy top-level notifications (if still used)
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // ==========================================
    // PREMIUM FEATURES & MONETIZATION
    // ==========================================
    
    // Helper: Get user subscription plan
    function getUserPlan(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.subscriptionPlan;
    }
    
    // Helper: Check premium user
    function isPremiumUser(userId) {
      let plan = getUserPlan(userId);
      return plan == 'basic' || plan == 'premium';
    }
    
    // Subscriptions - only server can write, users can read own
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create, update, delete: if false; // Server-only via Firebase Functions
    }
    
    // Premium Listings - only premium users can create
    match /premium_listings/{premiumListingId} {
      allow read: if true; // Public for display
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.userId &&
                      isPremiumUser(request.auth.uid);
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Payments - read-only for users, server writes
    match /payments/{paymentId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create, update, delete: if false; // Server-only
    }
    
    // Premium Analytics - only premium tier can access
    match /premium_analytics/{analyticsId} {
      allow read: if request.auth != null && getUserPlan(request.auth.uid) == 'premium';
      allow create, update, delete: if false; // Server-only
    }
    
    // User Stats - read own, server writes
    match /user_stats/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false; // Server-only
    }
    
    // ==========================================
    // PHASE 3: BARTER & NEGOTIATION SYSTEM
    // ==========================================
    
    // Barter Matches - users can read matches for their items
    match /barter_matches/{matchId} {
      allow read: if request.auth != null && 
                      (request.auth.uid == resource.data.sourceUserId || 
                       request.auth.uid == resource.data.targetUserId);
      allow create: if false; // Server-only via Cloud Functions
      allow update: if request.auth != null && 
                      (request.auth.uid == resource.data.sourceUserId || 
                       request.auth.uid == resource.data.targetUserId) &&
                      // Only allow status updates
                      request.resource.data.keys().hasOnly(['isSeen', 'isDismissed', 'seenAt', 'dismissedAt']);
      allow delete: if false; // Server-only
    }
    
    // Negotiations - participants can read/write
    match /negotiations/{negotiationId} {
      allow read: if request.auth != null && 
                      (request.auth.uid == resource.data.initiatorId || 
                       request.auth.uid == resource.data.responderId);
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.initiatorId;
      allow update: if request.auth != null && 
                      (request.auth.uid == resource.data.initiatorId || 
                       request.auth.uid == resource.data.responderId);
      allow delete: if false; // Keep for audit trail
    }
    
    // Counter Offers - negotiation participants can read/write
    match /counter_offers/{counterOfferId} {
      allow read: if request.auth != null && 
                      (request.auth.uid == resource.data.offererId || 
                       request.auth.uid == resource.data.targetUserId);
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.offererId;
      allow update: if request.auth != null && 
                      (request.auth.uid == resource.data.offererId || 
                       request.auth.uid == resource.data.targetUserId) &&
                      // Only allow response updates
                      request.resource.data.keys().hasOnly(['status', 'respondedAt', 'responseMessage']);
      allow delete: if false; // Keep for audit trail
    }
    
    // Trades - participants can read/write
    match /trades/{tradeId} {
      allow read: if request.auth != null && 
                      (request.auth.uid == resource.data.initiatorId || 
                       request.auth.uid == resource.data.receiverId);
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.initiatorId;
      allow update: if request.auth != null && 
                      (request.auth.uid == resource.data.initiatorId || 
                       request.auth.uid == resource.data.receiverId);
      allow delete: if false; // Keep for audit trail
    }
    
    // Item Views - for analytics and matching
    match /item_views/{viewId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.userId;
      allow update, delete: if false; // Server-only
    }
  }
}
